<table id="songs" class="table table-sm table-bordered table-hover small mb-0"><thead><tr><th rowspan="2" class="pinned">管理名<br>曲名</th><th colspan="{{songGroup.columns.length}}">{{songGroup.label}}</th><th colspan="{{difficulties.length}}">譜面 (譜面スロット=難易度)</th>{{#each assetGroups}}<th colspan="{{columns.length}}">{{label}}</th>{{/each}}<th rowspan="2">メモ</th></tr>
<tr>{{#each songGroup.columns}}{{> header this}}{{/each}}{{#each difficulties}}<th>{{slot}}={{label}}</th>{{/each}}{{#each assetGroups}}{{#each columns}}{{> header this}}{{/each}}{{/each}}</tr></thead><tbody>
{{#each rows}}
<tr{{#if classes}} class="{{classes}}"{{/if}} data-folder="{{folder}}"><td class="pinned clip-title"><div class="text-truncate" title="{{key}}">{{key}}</div><div class="text-truncate" title="{{title}}">{{title}}</div></td><td>{{generation}}<br>{{#if sourceFolder}}{{sourceFolder}}{{else}}—{{/if}}<br>{{folderText}}</td><td class="clip text-truncate"{{#if variantTitle}} title="{{variantTitle}}"{{/if}}>{{#each variant}}{{#unless @first}}<br>{{/unless}}{{this}}{{/each}}</td>{{#each levels}}{{#if none}}{{> none}}{{else}}<td class="text-end{{#if classes}} {{classes}}{{/if}}">{{#each parts}}<div{{#if classes}} class="{{classes}}"{{/if}}>{{level}}<br>{{notes}}{{#if compare}}<br>{{compare}}{{/if}}{{#if sameAs}}<br>{{sameAs}}{{/if}}{{#if sameIn}}<br><span title="{{sameIn.title}}">{{sameIn.text}}</span>{{/if}}{{#if from}}<br><span title="{{from.title}}">{{from.text}}</span>{{/if}}</div>{{/each}}</td>{{/if}}{{/each}}{{> size sound}}{{#each soundPrints}}{{> lines this}}{{/each}}{{> size video}}{{> refs videoRefs}}{{> size overlay}}{{#if overlaySheets}}<td class="text-end">{{overlaySheets}}</td>{{else}}{{> none}}{{/if}}{{> refs overlayRefs}}{{#if note}}<td>{{note}}</td>{{else}}{{> none}}{{/if}}</tr>
{{/each}}
</tbody></table>
